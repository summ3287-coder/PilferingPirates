Content2.CanvasSize = UDim2.new(0, 0, 0, 120)
Content2.ScrollBarThickness = 3
Content2.Parent = MainPanel

local espActive = false
local function applyESPToCharacter(char)
    if not char then return end
    task.wait(0.5)
    if char:FindFirstChild("GeminiESPBox") then
        char.GeminiESPBox:Destroy()
    end
    if espActive then
        local highlight = Instance.new("Highlight")
        highlight.Name = "GeminiESPBox"
        highlight.Adornee = char
        highlight.FillColor = Color3.fromRGB(0, 162, 255)
        highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
        highlight.FillTransparency = 0.5
        highlight.Parent = char
    end
end

createModernToggle(Content2, "เปิดระบบมองตัวผู้เล่น (Stable ESP)", 0, false, function(state)
    espActive = state
    if state then
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= localPlayer then
                if p.Character then applyESPToCharacter(p.Character) end
                p.CharacterAdded:Connect(function(newChar)
                    applyESPToCharacter(newChar)
                end)
            end
        end
    else
        for _, p in ipairs(Players:GetPlayers()) do
            if p.Character and p.Character:FindFirstChild("GeminiESPBox") then
                p.Character.GeminiESPBox:Destroy()
            end
        end
    end
end)

Players.PlayerAdded:Connect(function(p)
    p.CharacterAdded:Connect(function(newChar)
        if espActive and p ~= localPlayer then
            applyESPToCharacter(newChar)
        end
    end)
end)

