-- ฟังก์ชันเสริม: ขอบเมนูไฟรุ้งกระพริบวิบวับ
--------------------------------------------------
task.spawn(function()
   local CoreGui = game:GetService("CoreGui")
   local RunService = game:GetService("RunService")
   
   -- ค้นหาหน้าต่างหลักของ Rayfield เพื่อใส่เส้นขอบเรืองแสง
   local rayfieldGui = CoreGui:FindFirstChild("Rayfield")
   if rayfieldGui then
       local mainFrame = rayfieldGui:FindFirstChild("Main", true)
       if mainFrame then
           -- สร้าง UIStroke สำหรับทำเส้นขอบรอบเมนู
           local uiStroke = mainFrame:FindFirstChild("RainbowBorder") or Instance.new("UIStroke")
           uiStroke.Name = "RainbowBorder"
           uiStroke.Thickness = 3 -- ความหนาของเส้นขอบไฟ
           uiStroke.Parent = mainFrame
           
           -- ลูปเปลี่ยนสีรุ้งวิบวับตลอดเวลา
           RunService.RenderStepped:Connect(function()
               uiStroke.Color = Color3.fromHSV(tick() % 5 / 5, 1, 1)
           end)
       end
   end
end)

