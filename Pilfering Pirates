        tracerColorIndex = tracerColorIndex + 1
        if tracerColorIndex > #tracerColors then tracerColorIndex = 1 end
        colorBtn.BackgroundColor3 = tracerColors[tracerColorIndex]
        colorBtn.Text = colorNames[tracerColorIndex]
    end)
end

