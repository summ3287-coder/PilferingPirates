local flyingActive = false
local flyConnection = nil

local function stopFlying()
    if not flyingActive then return end
    flyingActive = false
    FlyFloatBtn.BackgroundColor3 = Color3.fromRGB(30, 30, 38)
    FlyFloatBtn.Text = "✈️ บินขึ้นฟ้า [OFF]"
    if flyConnection then flyConnection:Disconnect() end
    pcall(function()
        local char = localPlayer.Character
        if char then
            local hum = char:FindFirstChildOfClass("Humanoid")
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if hum then hum.PlatformStand = false end
            if hrp then hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0) end
        end
    end)
end

FlyFloatBtn.MouseButton1Click:Connect(function()
    if flyingActive then
        stopFlying()
    else
        flyingActive = true
        FlyFloatBtn.BackgroundColor3 = Color3.fromRGB(0, 120, 80)
        FlyFloatBtn.Text = "✈️ บินขึ้นฟ้า [ON]"
        
        local startTime = tick()
        flyConnection = RunService.RenderStepped:Connect(function()
            if tick() - startTime >= 10 then
                stopFlying()
                return
            end
            pcall(function()
                local char = localPlayer.Character
                if char and char:FindFirstChild("HumanoidRootPart") then
                    local hrp = char.HumanoidRootPart
                    local hum = char:FindFirstChildOfClass("Humanoid")
                    if hum then hum.PlatformStand = true end
                    hrp.AssemblyLinearVelocity = Vector3.new(0, 18, 0)
                end
            end)
        end)
    end
end)

