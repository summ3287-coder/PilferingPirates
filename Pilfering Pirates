-- ลูปเร่งความเร็วการโจมตี (ถ้าเกมรองรับการรีเซ็ตคูลดาวน์อาวุธ)
task.spawn(function()
   while true do
       if FastAttackEnabled then
           pcall(function()
               local char = LocalPlayer.Character
               if char then
                   for _, tool in pairs(char:GetChildren()) do
                       if tool:IsA("Tool") and tool:FindFirstChild("Cooldwn") then
                           tool.Cooldwn.Value = 0
                       end
                   end
               end
           end)
       end
       task.wait(0.1)
   end
end)

-- รายชื่อผู้เล่นสำหรับระบบล็อกเป้า
local lockPlayerList = {}
for _, p in pairs(Players:GetPlayers()) do
