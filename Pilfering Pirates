})

FunTab:CreateButton({
   Name = "[สูงสุด] ลดแลก เวล 4: ลบแมพเกลี้ยงเกลา (ลบทุกสิ่ง)",
   Callback = function()
       for _, v in pairs(Workspace:GetChildren()) do
