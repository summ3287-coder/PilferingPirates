-- 2. ฟังก์ชันเดิม: Giant Size & Rainbow Color ตัวละคร
--------------------------------------------------
FunTab:CreateToggle({
   Name = "🗿 โหมดตัวใหญ่ยักษ์ (Giant Size)",
   CurrentValue = false,
   Flag = "GiantToggle",
   Callback = function(Value)
       local char = LocalPlayer.Character
       if char and char:FindFirstChild("Humanoid") then
           for _, v in pairs(char:GetDescendants()) do
               if v:IsA("BasePart") then
                   v.Size = Value and v.Size * 2 or v.Size / 2
               end
           end
       end
   end,
})

FunTab:CreateToggle({
   Name = "🌈 ตัวสีรุ้งวิบวับ (Rainbow Color)",
   CurrentValue = false,
   Flag = "RainbowToggle",
   Callback = function(Value)
       _G.RainbowEnabled = Value
       task.spawn(function()
           while _G.RainbowEnabled do
               local char = LocalPlayer.Character
               if char then
                   for _, v in pairs(char:GetDescendants()) do
                       if v:IsA("BasePart") then
                           v.Color = Color3.fromHSV(tick() % 5 / 5, 1, 1)
                       end
                   end
               end
               task.wait(0.1)
           end
       end)
   end,
})

