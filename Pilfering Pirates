-- ลูปวาด ESP
RunService.RenderStepped:Connect(function()
    -- ล้างภาพเก่าทิ้งก่อน
    for _, obj in pairs(espDrawings) do
        pcall(function() obj:Remove() end)
    end
    espDrawings = {}

    if not espLineEnabled and not espBoxEnabled then return end

    for _, p in pairs(Players:GetPlayers()) do
        if p ~= localPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") and p.Character:FindFirstChildOfClass("Humanoid") then
            local hum = p.Character:FindFirstChildOfClass("Humanoid")
            if hum.Health > 0 then
                local hrp = p.Character.HumanoidRootPart
                local vector, onScreen = Camera:WorldToViewportPoint(hrp.Position)
                
                if onScreen then
                    -- วาดเส้นตรง (Line)
                    if espLineEnabled then
                        local line = Drawing.new("Line")
                        line.From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
                        line.To = Vector2.new(vector.X, vector.Y)
                        line.Color = espColor
                        line.Thickness = 1.5
                        line.Transparency = 1
                        table.insert(espDrawings, line)
                    end
                    
                    -- วาดกรอบสี่เหลี่ยม (Box)
                    if espBoxEnabled then
                        local box = Drawing.new("Square")
                        box.Size = Vector2.new(2000 / vector.Z, 3000 / vector.Z)
                        box.Position = Vector2.new(vector.X - box.Size.X / 2, vector.Y - box.Size.Y / 2)
                        box.Color = espColor
                        box.Thickness = 1.5
                        box.Filled = false
                        box.Transparency = 1
                        table.insert(espDrawings, box)
                    end
                end
            end
        end
    end
end)

