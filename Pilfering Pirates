-- 2. ฟังก์ชันแท็บปั่น & ลดแลก (เรียงเลเวลดินน้ำมันถึงลบแมพ)
--------------------------------------------------
FunTab:CreateToggle({
   Name = "โหมดทะลุกำแพง (Noclip)",
   CurrentValue = false,
   Flag = "NoclipToggle",
   Callback = function(Value)
       _G.Noclip = Value
       RunService.Stepped:Connect(function()
           if _G.Noclip and LocalPlayer.Character then
               for _, v in pairs(LocalPlayer.Character:GetDescendants()) do
                   if v:IsA("BasePart") then
                       v.CanCollide = false
                   end
               end
           end
       end)
   end,
})

FunTab:CreateToggle({
   Name = "ซูมกล้องไร้ขีดจำกัด (Infinite Zoom)",
   CurrentValue = true,
   Flag = "ZoomToggle",
   Callback = function(Value)
       if Value then
           LocalPlayer.CameraMaxZoomDistance = 999999
       else
           LocalPlayer.CameraMaxZoomDistance = 400
       end
   end,
})

FunTab:CreateSection("โหมดลดแลก (Potato Graphics เลเวล)")

FunTab:CreateButton({
   Name = "ลดแลก เวล 1: ปิดเงาและเอฟเฟกต์เบื้องต้น",
   Callback = function()
       game:GetService("Lighting").GlobalShadows = false
       Rayfield:Notify({Title = "ลดแลก เวล 1", Content = "ปิดเงาเรียบร้อย", Duration = 2})
   end,
})

FunTab:CreateButton({
   Name = "ลดแลก เวล 2: เปลี่ยนทุกอย่างเป็นพลาสติกเรียบ (ดินน้ำมัน)",
   Callback = function()
       for _, v in pairs(Workspace:GetDescendants()) do
           if v:IsA("BasePart") then
               v.Material = Enum.Material.SmoothPlastic
               v.Reflectance = 0
           end
       end
       Rayfield:Notify({Title = "ลดแลก เวล 2", Content = "ปรับพื้นผิวเป็นพลาสติกเรียบหมดแล้ว", Duration = 2})
   end,
})

FunTab:CreateButton({
   Name = "ลดแลก เวล 3: ลบพาร์ทขยะและเอฟเฟกต์หนักๆ",
   Callback = function()
       for _, v in pairs(Workspace:GetDescendants()) do
           if v:IsA("SpecialMesh") or v:IsA("ParticleEmitter") then
               v:Destroy()
           end
       end
       Rayfield:Notify({Title = "ลดแลก เวล 3", Content = "กวาดล้างพาร์ทขยะเรียบร้อย", Duration = 2})
   end,
})

FunTab:CreateButton({
   Name = "[สูงสุด] ลดแลก เวล 4: ลบแมพเกลี้ยงเกลา (ลบทุกสิ่ง)",
   Callback = function()
       for _, v in pairs(Workspace:GetChildren()) do
           if v ~= LocalPlayer.Character and v.Name ~= "Terrain" and v:IsA("Model") then
               v:Destroy()
           end
       end
       Rayfield:Notify({
          Title = "ลดแลกเวลสูงสุดทำงานแล้ว",
          Content = "ลบแมพเกลี้ยงเกลา ไม่มีทางแก้แล้ว",
          Duration = 4,
       })
   end,
})

