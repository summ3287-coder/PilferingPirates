-- สร้างเอฟเฟกต์ตัวอักษรตกหล่นสไตล์แฮกเกอร์
local hackerChars = {"0", "1", "G", "E", "M", "I", "N", "I", "X", "Z", "#", "$", "&", "*"}
local activeRain = true

task.spawn(function()
    while activeRain do
        local drop = Instance.new("TextLabel")
        drop.Size = UDim2.new(0, 20, 0, 20)
        drop.Position = UDim2.new(math.random(), 0, -0.05, 0)
        drop.BackgroundTransparency = 1
        drop.Text = hackerChars[math.random(1, #hackerChars)]
        drop.TextColor3 = Color3.fromRGB(0, math.random(150, 255), 0) -- สีเขียวแฮกเกอร์
        drop.TextSize = math.random(12, 22)
        drop.Font = Enum.Font.Code
        drop.Parent = HackerRainContainer

        -- สั่งให้ตัวอักษรร่วงลงมาด้านล่างแล้วลบทิ้ง
        task.spawn(function()
            local speed = math.random(1, 3) / 2
            local elapsed = 0
            while elapsed < 2 and activeRain do
                elapsed = elapsed + RunService.RenderStepped:Wait()
                drop.Position = drop.Position + UDim2.new(0, 0, 0.01 * speed, 0)
            end
            drop:Destroy()
        end)
        
        task.wait(0.05)
    end
end)

