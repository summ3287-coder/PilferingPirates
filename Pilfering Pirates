                           hrp.CFrame = CFrame.new(hrp.Position.X, raycastResult.Position.Y + 3, hrp.Position.Z)
                           hrp.AssemblyLinearVelocity = Vector3.new(hrp.AssemblyLinearVelocity.X, 0, hrp.AssemblyLinearVelocity.Z)
                       end
                   end
                   task.wait(0.03)
               end
           end)
