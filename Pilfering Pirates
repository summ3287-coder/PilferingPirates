-- ฟังก์ชันสร้างปุ่มกดเปิด-ปิดฟีเจอร์ (Toggle Buttons) ในหน้าฟาร์ม
local function createFeatureToggle(parent, text, yPos, callback)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, 0, 0, 40)
    btn.Position = UDim2.new(0, 0, 0, yPos)
    btn.BackgroundColor3 = Color3.fromRGB(26, 26, 32)
    btn.Text = "  " .. text .. " [ ปิด ]"
    btn.TextColor3 = Color3.fromRGB(210, 210, 210)
    btn.TextSize = 12
    btn.Font = Enum.Font.GothamMedium
    btn.TextXAlignment = Enum.TextXAlignment.Left
    btn.Parent = parent
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 8)
    
    local active = false
    btn.MouseButton1Click:Connect(function()
        active = not active
        if active then
            btn.BackgroundColor3 = Color3.fromRGB(0, 120, 80)
            btn.Text = "  " .. text .. " [ เปิดใช้งาน ]"
        else
            btn.BackgroundColor3 = Color3.fromRGB(26, 26, 32)
            btn.Text = "  " .. text .. " [ ปิด ]"
        end
        callback(active)
    end)
end

