-- ระบบเล่น/หยุดเสียง
local currentSound = nil

playBtn.MouseButton1Click:Connect(function()
    local idNum = tonumber(soundBox.Text)
    local char = localPlayer.Character
    if idNum and char and char:FindFirstChild("HumanoidRootPart") then
        if currentSound and currentSound.Parent then
            currentSound:Stop()
            currentSound:Destroy()
        end
        
        local sound = Instance.new("Sound")
        sound.SoundId = "rbxassetid://" .. tostring(idNum)
        sound.Volume = 15
        sound.RollOffMaxDistance = 1000
        sound.RollOffMinDistance = 10
        sound.Parent = char.HumanoidRootPart
        
        currentSound = sound
        sound:Play()
        
        sound.Ended:Connect(function()
            if currentSound == sound then currentSound = nil end
            sound:Destroy()
        end)
    end
end)

stopBtn.MouseButton1Click:Connect(function()
    if currentSound and currentSound.Parent then
        currentSound:Stop()
        currentSound:Destroy()
        currentSound = nil
    end
end)

-- กดปุ่ม X เพื่อปิดเมนู, กดตัว G เพื่อเปิดเมนูคืน
CloseButton.MouseButton1Click:Connect(function()
    MainPanel.Visible = false
    ToggleButton.Visible = true
end)

ToggleButton.MouseButton1Click:Connect(function()
    MainPanel.Visible = true
    ToggleButton.Visible = false
end)

-- ระบบลากหน้าต่างอิสระ
local dragging, dragInput, dragStart, startPos
TopBar.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true; dragStart = input.Position; startPos = MainPanel.Position
    end
end)

TopBar.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
        dragInput = input
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if input == dragInput and dragging then
        local delta = input.Position - dragStart
        MainPanel.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)
