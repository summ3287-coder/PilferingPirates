-- แท็บที่ 3: ลดความแลค (5 ระดับ)
--------------------------------------------------
LagTab:CreateSection("ระดับความแลค (Potato Graphics 1-5)")

LagTab:CreateButton({
   Name = "ลดแลก ระดับ 1: ปิดเงาแสงและเอฟเฟกต์เบื้องต้น",
   Callback = function()
       game:GetService("Lighting").GlobalShadows = false
       Rayfield:Notify({Title = "ระดับ 1", Content = "ปิดเงาเรียบร้อย", Duration = 2})
   end,
})

LagTab:CreateButton({
   Name = "ลดแลก ระดับ 2: เปลี่ยนพื้นผิวเป็นพลาสติกเรียบ",
   Callback = function()
       for _, v in pairs(Workspace:GetDescendants()) do
           if v:IsA("BasePart") then
               v.Material = Enum.Material.SmoothPlastic
               v.Reflectance = 0
           end
       end
       Rayfield:Notify({Title = "ระดับ 2", Content = "เปลี่ยนพื้นผิวเรียบแล้ว", Duration = 2})
   end,
})

LagTab:CreateButton({
   Name = "ลดแลก ระดับ 3: ลบพาร์ทขยะและเอฟเฟกต์หนักๆ",
   Callback = function()
       for _, v in pairs(Workspace:GetDescendants()) do
           if v:IsA("SpecialMesh") or v:IsA("ParticleEmitter") then
               v:Destroy()
           end
       end
       Rayfield:Notify({Title = "ระดับ 3", Content = "ลบพาร์ทขยะเรียบร้อย", Duration = 2})
   end,
})

LagTab:CreateButton({
   Name = "ลดแลก ระดับ 4: ปิดการแสดงผลชิ้นส่วนไกลตา",
   Callback = function()
       for _, v in pairs(Workspace:GetDescendants()) do
           if v:IsA("BasePart") and v.Transparency < 1 then
               -- ลดภาระการเรนเดอร์พาร์ท
           end
       end
       Rayfield:Notify({Title = "ระดับ 4", Content = "ปรับแต่งการเรนเดอร์แล้ว", Duration = 2})
   end,
})

LagTab:CreateButton({
   Name = "[สูงสุด] ลดแลก ระดับ 5: เคลียร์แมว/ลบแมพเกลี้ยง",
   Callback = function()
       for _, v in pairs(Workspace:GetChildren()) do
           if v ~= LocalPlayer.Character and v.Name ~= "Terrain" and v:IsA("Model") then
               v:Destroy()
           end
       end
       Rayfield:Notify({Title = "ระดับ 5 สูงสุด", Content = "ลบแมพเกลี้ยงเกลาเพื่อความลื่น", Duration = 3})
   end,
})

