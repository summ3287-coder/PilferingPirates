    boxLbl.TextColor3 = Color3.fromRGB(150, 150, 150)
    boxLbl.TextSize, boxLbl.Font, boxLbl.TextXAlignment = 12, Enum.Font.Gotham, Enum.TextXAlignment.Left
    boxLbl.Parent = frame

    table.insert(uiElementsToTranslate, {obj = boxLbl, key = "valueLbl", type = "text"})

    local box = Instance.new("TextBox")
    box.Size = UDim2.new(0, 60, 0, 26)
    box.Position = UDim2.new(0, 130, 0, 41)
    box.BackgroundColor3 = Color3.fromRGB(35, 35, 40)
    box.Text = tostring(defaultVal)
    box.TextColor3 = Color3.fromRGB(255, 255, 255)
    box.TextSize, box.Font = 12, Enum.Font.GothamBold
    box.Parent = frame
    Instance.new("UICorner", box).CornerRadius = UDim.new(0, 6)

    local active = false
    local currentVal = defaultVal

    switchBg.MouseButton1Click:Connect(function()
        active = not active
        if active then
            switchBg.BackgroundColor3 = Color3.fromRGB(0, 162, 255)
            switchDot:TweenPosition(UDim2.new(1, -23, 0.5, -10), Enum.EasingDirection.Out, Enum.EasingStyle.Quad, 0.15, true)
        else
            switchBg.BackgroundColor3 = Color3.fromRGB(45, 45, 50)
            switchDot:TweenPosition(UDim2.new(0, 3, 0.5, -10), Enum.EasingDirection.Out, Enum.EasingStyle.Quad, 0.15, true)
        end
        callback(active, currentVal)
    end)

    box.FocusLost:Connect(function()
        local val = tonumber(box.Text)
        if val then
            if val < 1 then val = 1 elseif val > 100 then val = 100 end
            box.Text = tostring(val)
            currentVal = val
        else
            box.Text = tostring(defaultVal)
            currentVal = defaultVal
        end
        if active then callback(true, currentVal) end
    end)
end


