-- Gemini Hub | John Wick Edition (No Emoji Version)
local repo = 'https://raw.githubusercontent.com/shlexware/Rayfield/main/'
local Rayfield = loadstring(game:HttpGet(repo .. 'Rayfield.lua'))()

local Window = Rayfield:CreateWindow({
   Name = "Gemini Hub | John Wick Edition",
   LoadingTitle = "Gemini Hub Loading...",
   LoadingSubtitle = "by You",
   ConfigurationSaving = {
      Enabled = false,
   },
   KeySystem = false,
})

-- 1. แท็บ ESP และการมองเห็น
local ESPTab = Window:CreateTab("ESP และการมองเห็น", 4483362458)

ESPTab:CreateToggle({
   Name = "มองทะลุกำแพง",
   CurrentValue = false,
   Flag = "ESPFlag",
   Callback = function(Value)
      local Players = game:GetService("Players")
      local localPlayer = Players.LocalPlayer
      for _, player in ipairs(Players:GetPlayers()) do
         if player ~= localPlayer and player.Character then
            local highlight = player.Character:FindFirstChild("GeminiESP")
            if Value and not highlight then
               local hl = Instance.new("Highlight")
               hl.Name = "GeminiESP"
               hl.Adornee = player.Character
               hl.FillColor = Color3.fromRGB(255, 0, 0)
               hl.Parent = player.Character
            elseif not Value and highlight then
               highlight:Destroy()
            end
         end
      end
   end,
})

ESPTab:CreateToggle({
   Name = "เดินทะลุกำแพง",
   CurrentValue = false,
   Flag = "NoclipFlag",
   Callback = function(Value)
      -- Noclip logic
   end,
})

ESPTab:CreateToggle({
   Name = "หมุนตัวป่วน",
   CurrentValue = false,
   Flag = "SpinFlag",
   Callback = function(Value)
      -- Spinbot logic
   end,
})

-- 2. แท็บ เทเลพอร์ต
local TP_Tab = Window:CreateTab("เทเลพอร์ต", 4483362458)

TP_Tab:CreateButton({
   Name = "เทเลพอร์ตไปหาเพื่อนร่วมทีม",
   Callback = function()
      local Players = game:GetService("Players")
      local localPlayer = Players.LocalPlayer
      for _, p in ipairs(Players:GetPlayers()) do
         if p ~= localPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
            localPlayer.Character.HumanoidRootPart.CFrame = p.Character.HumanoidRootPart.CFrame + Vector3.new(0, 3, 0)
            break
         end
      end
   end,
})

-- 3. แท็บ ปรับแต่ง UI และตั้งค่า
local SettingsTab = Window:CreateTab("ปรับแต่ง UI และตั้งค่า", 4483362458)

SettingsTab:CreateButton({
   Name = "รีเซ็ตตัวละคร",
   Callback = function()
      local Players = game:GetService("Players")
      if Players.LocalPlayer.Character then
         Players.LocalPlayer.Character:BreakJoints()
      end
   end,
})

Rayfield:LoadConfiguration()
