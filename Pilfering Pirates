local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()

local Window = Rayfield:CreateWindow({
   Name = "Gemini Hub | John Wick Edition",
   LoadingTitle = "Loading Gemini Hub...",
   LoadingSubtitle = "By John Wick",
   ConfigurationSaving = {
      Enabled = false,
   },
   KeySystem = false,
})

local VisualTab = Window:CreateTab("ESP & Visual", 4483362458)

local LocalPlayer = game.Players.LocalPlayer
local Workspace = game:GetService("Workspace")
local RunService = game:GetService("RunService")
local Camera = Workspace.CurrentCamera

Rayfield:Notify({
   Title = "Gemini Hub",
   Content = "ESP Mode Loaded",
   Duration = 3,
   Image = 4483362458,
})

_G.ESPBox = false
_G.ESPTracer = false
_G.ESPColor = Color3.fromRGB(255, 0, 0)

VisualTab:CreateToggle({
   Name = "ESP Box (Highlight)",
   CurrentValue = false,
   Flag = "ESPBoxToggle",
   Callback = function(Value)
       _G.ESPBox = Value
   end,
})

VisualTab:CreateToggle({
   Name = "ESP Tracer (Lines)",
   CurrentValue = false,
   Flag = "ESPTracerToggle",
   Callback = function(Value)
       _G.ESPTracer = Value
   end,
})

VisualTab:CreateColorPicker({
   Name = "ESP Color",
   Color = Color3.fromRGB(255, 0, 0),
   Flag = "ESPColorPicker",
   Callback = function(Value)
       _G.ESPColor = Value
   end,
})

local tracers = {}

RunService.RenderStepped:Connect(function()
   for _, player in pairs(game.Players:GetPlayers()) do
       if player ~= LocalPlayer and player.Character then
           local char = player.Character
           local rootPart = char:FindFirstChild("HumanoidRootPart")
           local highlight = char:FindFirstChild("GeminiESPBox")
           
           -- จัดการกรอบ ESP
           if _G.ESPBox then
               if not highlight then
                   highlight = Instance.new("Highlight")
                   highlight.Name = "GeminiESPBox"
                   highlight.Adornee = char
                   highlight.Parent = char
                   highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
               end
               highlight.FillTransparency = 1
               highlight.OutlineTransparency = 0
               highlight.OutlineColor = _G.ESPColor
           else
               if highlight then
                   highlight:Destroy()
               end
           end

           -- จัดการเส้น Tracer
           if _G.ESPTracer and rootPart then
               if not tracers[player] then
                   local success, line = pcall(function()
                       return Drawing.new("Line")
                   end)
                   if success and line then
                       line.Thickness = 1.5
                       line.Visible = false
                       tracers[player] = line
                   end
               end
               
               local line = tracers[player]
               if line then
                   local vector, onScreen = Camera:WorldToViewportPoint(rootPart.Position)
                   if onScreen then
                       line.From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
                       line.To = Vector2.new(vector.X, vector.Y)
                       line.Color = _G.ESPColor
                       line.Visible = true
                   else
                       line.Visible = false
                   end
               end
           else
               if tracers[player] then
                   tracers[player].Visible = false
               end
           end
       end
   end
end)
