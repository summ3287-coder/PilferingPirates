-- --- 4. ฟีเจอร์ใหม่: ระบบมอง (ESP เส้นโยง + กรอบสี่เหลี่ยม) ---
local espActive = false
local espDrawings = {}
createFeatureToggle(pageAuto, "👁️ ระบบมอง (ESP กรอบ & เส้นโยงศัตรู)", 150, "esp", function(state)
    espActive = state
    if not state then
        for _, d in pairs(espDrawings) do
            if d.box then d.box:Remove() end
            if d.line then d.line:Remove() end
        end
        espDrawings = {}
    end
end)

RunService.RenderStepped:Connect(function()
    if not espActive then return end
    pcall(function()
        for _, p in pairs(Players:GetPlayers()) do
            if p ~= localPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                local hrp = p.Character.HumanoidRootPart
                local vector, onScreen = Camera:WorldToViewportPoint(hrp.Position)
                
                if not espDrawings[p] then
                    local box = Drawing.new("Square")
                    box.Visible = false
                    box.Color = Color3.fromRGB(0, 162, 255)
                    box.Thickness = 1
                    box.Filled = false
                    
                    local line = Drawing.new("Line")
                    line.Visible = false
                    line.Color = Color3.fromRGB(0, 162, 255)
                    line.Thickness = 1
                    
                    espDrawings[p] = {box = box, line = line}
                end
                
                local d = espDrawings[p]
                if onScreen then
                    d.box.Visible = true
                    d.box.Size = Vector2.new(2000 / vector.Z, 3500 / vector.Z)
                    d.box.Position = Vector2.new(vector.X - d.box.Size.X / 2, vector.Y - d.box.Size.Y / 2)
                    
                    d.line.Visible = true
                    d.line.From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
                    d.line.To = Vector2.new(vector.X, vector.Y)
                else
                    d.box.Visible = false
                    d.line.Visible = false
                end
            elseif espDrawings[p] then
                if espDrawings[p].box then espDrawings[p].box:Remove() end
                if espDrawings[p].line then espDrawings[p].line:Remove() end
                espDrawings[p] = nil
            end
        end
    end)
end)

