-- ระบบปรับสีเส้น Tracer
local tracerColorIndex = 1
local tracerColors = {Color3.fromRGB(0, 255, 0), Color3.fromRGB(255, 0, 0), Color3.fromRGB(0, 162, 255), Color3.fromRGB(255, 255, 0)}
local colorNames = {"เขียว", "แดง", "ฟ้า", "เหลือง"}

