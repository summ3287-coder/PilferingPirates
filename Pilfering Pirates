-- ฟังก์ชันสร้างช่องปรับตัวเลข 1-50 ในหน้าหลัก
local function createSlider(name, yPos, callback)
    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(1, 0, 0, 55)
    frame.Position = UDim2.new(0, 0, 0, yPos)
    frame.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
    frame.Parent = Content1
    Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 6)

    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(0.6, 0, 1, 0)
    lbl.Position = UDim2.new(0, 12, 0, 0)
    lbl.BackgroundTransparency = 1
    lbl.Text = name .. " (1-50)"
    lbl.TextColor3 = Color3.fromRGB(240, 240, 240)
    lbl.TextSize, lbl.Font, lbl.TextXAlignment = 13, Enum.Font.Gotham, Enum.TextXAlignment.Left
    lbl.Parent = frame

    local box = Instance.new("TextBox")
    box.Size = UDim2.new(0, 70, 0, 32)
    box.Position = UDim2.new(1, -80, 0.5, -16)
    box.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
    box.Text = "1"
    box.TextColor3 = Color3.fromRGB(255, 255, 255)
    box.TextSize, box.Font = 13, Enum.Font.GothamBold
    box.Parent = frame
    Instance.new("UICorner", box).CornerRadius = UDim.new(0, 4)

    box.FocusLost:Connect(function()
        local val = tonumber(box.Text)
        if val then
            if val < 1 then val = 1 elseif val > 50 then val = 50 end
            box.Text = tostring(val)
            callback(val)
        else
            box.Text = "1"
            callback(1)
        end
    end)
end

