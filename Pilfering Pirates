--------------------------------------------------
-- แท็บที่ 1: หน้าหลัก (ต้านแรงโน้มถ่วง, หมุนตัว, ทะลุกำแพง, บังคับมุมมองที่ 3)
--------------------------------------------------
MainTab:CreateSection("ระบบเคลื่อนไหว & ป่วนพิเศษ")

_G.AntiGravity = false
MainTab:CreateToggle({
   Name = "โหมดต้านแรงโน้มถ่วง (กระโดดลอยตัวสโลว์)",
   CurrentValue = false,
   Flag = "AntiGravityToggle",
   Callback = function(Value)
       _G.AntiGravity = Value
       if Workspace then
           Workspace.Gravity = Value and 30 or 196.2
       end
   end,
})

_G.SpinBot = false
MainTab:CreateToggle({
   Name = "โหมดหมุนตัวอัตโนมัติ (Spinbot)",
   CurrentValue = false,
   Flag = "SpinBotToggle",
   Callback = function(Value)
       _G.SpinBot = Value
   end,
})

_G.Noclip = false
MainTab:CreateToggle({
   Name = "โหมดทะลุกำแพง (Noclip)",
   CurrentValue = false,
   Flag = "NoclipToggle",
   Callback = function(Value)
       _G.Noclip = Value
   end,
})

_G.ForceThirdPerson = false
MainTab:CreateToggle({
   Name = "บังคับมุมมองบุคคลที่ 3 (แก้แมพล็อกมุมมอง)",
   CurrentValue = false,
   Flag = "ForceTPToggle",
   Callback = function(Value)
       _G.ForceThirdPerson = Value
       if Value then
           LocalPlayer.CameraMode = Enum.CameraMode.Classic
           LocalPlayer.DevComputerCameraMode = Enum.DevComputerCameraMode.Classic
           LocalPlayer.DevTouchCameraMode = Enum.DevTouchCameraMode.Classic
       end
   end,
})

RunService.RenderStepped:Connect(function()
   if _G.SpinBot and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
       LocalPlayer.Character.HumanoidRootPart.CFrame = LocalPlayer.Character.HumanoidRootPart.CFrame * CFrame.Angles(0, math.rad(30), 0)
   end

   if _G.Noclip and LocalPlayer.Character then
       for _, v in pairs(LocalPlayer.Character:GetDescendants()) do
           if v:IsA("BasePart") then
               v.CanCollide = false
           end
       end
   end

   if _G.ForceThirdPerson then
       LocalPlayer.CameraMode = Enum.CameraMode.Classic
   end
end)

--------------------------------------------------
-- แท็บที่ 2: หน้ามอง (ESP กรอบ, เส้น Tracer, วงกลมกลางจอ, เลือกสี)
--------------------------------------------------
_G.ESPBox = false
_G.ESPTracer = false
_G.FOVCircle = false
_G.ESPColor = Color3.fromRGB(255, 0, 0)

VisualTab:CreateToggle({
   Name = "มองเป็นกรอบสี่เหลี่ยม (ESP Box)",
   CurrentValue = false,
   Flag = "ESPBoxToggle",
   Callback = function(Value)
       _G.ESPBox = Value
   end,
})

VisualTab:CreateToggle({
   Name = "มองเส้นโยงเป้าหมาย (ESP Tracer)",
   CurrentValue = false,
   Flag = "ESPTracerToggle",
   Callback = function(Value)
       _G.ESPTracer = Value
   end,
})

VisualTab:CreateToggle({
   Name = "วงกลมกลางจอ (FOV Circle)",
   CurrentValue = false,
   Flag = "FOVCircleToggle",
   Callback = function(Value)
       _G.FOVCircle = Value
   end,
})

VisualTab:CreateColorPicker({
   Name = "ปรับสี ESP & วงกลม",
   Color = Color3.fromRGB(255, 0, 0),
   Flag = "ESPColorPicker",
   Callback = function(Value)
       _G.ESPColor = Value
   end,
})

local successCircle, fovCircle = pcall(function()
   local circle = Drawing.new("Circle")
   circle.Visible = false
   circle.Radius = 120
   circle.Thickness = 1.5
   circle.Filled = false
   circle.NumSides = 60
   return circle
end)

local tracers = {}

RunService.RenderStepped:Connect(function()
   if successCircle and fovCircle then
       if _G.FOVCircle then
           fovCircle.Visible = true
           fovCircle.Position = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
           fovCircle.Color = _G.ESPColor
       else
           fovCircle.Visible = false
       end
   end

   for _, player in pairs(game.Players:GetPlayers()) do
       if player ~= LocalPlayer and player.Character then
           local char = player.Character
           local rootPart = char:FindFirstChild("HumanoidRootPart")
           local highlight = char:FindFirstChild("GeminiESPBox")
           
           if _G.ESPBox then
               if not highlight then
                   highlight = Instance.new("Highlight")
                   highlight.Name = "GeminiESPBox"
                   highlight.Adornee = char
                   highlight.Parent = char
                   highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
               end
               highlight.FillTransparency = 1
               highlight.OutlineTransparency = 0
               highlight.OutlineColor = _G.ESPColor
           else
               if highlight then
                   highlight:Destroy()
               end
           end

           if _G.ESPTracer and rootPart then
               if not tracers[player] then
                   local success, line = pcall(function()
                       return Drawing.new("Line")
                   end)
                   if success and line then
                       line.Thickness = 1.5
                       line.Visible = false
                       tracers[player] = line
                   end
               end
               
               local line = tracers[player]
               if line then
                   local vector, onScreen = Camera:WorldToViewportPoint(rootPart.Position)
                   if onScreen then
                       line.From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
                       line.To = Vector2.new(vector.X, vector.Y)
                       line.Color = _G.ESPColor
                       line.Visible = true
                   else
                       line.Visible = false
                   end
               end
           else
               if tracers[player] then
                   tracers[player].Visible = false
               end
           end
       end
   end
end)

