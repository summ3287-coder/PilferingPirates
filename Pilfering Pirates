-- --- 6. ฟีเจอร์ใหม่: ระบบลอยตัวทะลุกำแพงช้าๆ (10 วินาทีแล้วค้าง) ---
local floatTween = nil
createFeatureToggle(pageAuto, "🛸 ลอยตัวทะลุกำแพงช้าๆ (ค้างบนฟ้า)", 250, "floatup", function(state)
    pcall(function()
