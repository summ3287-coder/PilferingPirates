--------------------------------------------------
-- 4. ฟังก์ชันล่องหน (Invisibility)
--------------------------------------------------
local InvisibilityEnabled = false
local storedParts = {}

FunTab:CreateToggle({
   Name = "🥷 โหมดล่องหนไร้ร่องรอย (Invisibility)",
   CurrentValue = false,
   Flag = "InvisibilityToggle",
   Callback = function(Value)
       InvisibilityEnabled = Value
       local char = LocalPlayer.Character
       if not char then return end
       
       if InvisibilityEnabled then
           for _, v in pairs(char:GetDescendants()) do
               if v:IsA("BasePart") or v:IsA("Decal") then
                   storedParts[v] = v.Transparency
                   v.Transparency = 1
               elseif v:IsA("Accessory") then
                   local handle = v:FindFirstChild("Handle")
                   if handle then
                       storedParts[handle] = handle.Transparency
                       handle.Transparency = 1
                   end
               end
           end
           Rayfield:Notify({Title = "🥷 ล่องหนสำเร็จ", Content = "หายตัวจากสายตาคนอื่นแล้ว", Duration = 2})
       else
           for v, originalTransparency in pairs(storedParts) do
               if v and v.Parent then
                   v.Transparency = originalTransparency
               end
           end
           storedParts = {}
           Rayfield:Notify({Title = "🥷 คืนร่างเดิม", Content = "แสดงตัวตนปกติเรียบร้อย", Duration = 2})
       end
   end,
})

