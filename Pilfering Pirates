local function createToggleSlider(name, yPos, defaultVal, callback)
    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(1, 0, 0, 65)
    frame.Position = UDim2.new(0, 0, 0, yPos)
    frame.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
    frame.Parent = Content1
    Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 6)

    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(0.5, 0, 0, 35)
    lbl.Position = UDim2.new(0, 12, 0, 0)
    lbl.BackgroundTransparency = 1
    lbl.Text = name
    lbl.TextColor3 = Color3.fromRGB(240, 240, 240)
    lbl.TextSize, lbl.Font, lbl.TextXAlignment = 13, Enum.Font.GothamBold, Enum.TextXAlignment.Left
    lbl.Parent = frame

    local toggleBtn = Instance.new("TextButton")
    toggleBtn.Size = UDim2.new(0, 60, 0, 28)
    toggleBtn.Position = UDim2.new(1, -70, 0, 6)
    toggleBtn.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
    toggleBtn.Text = "ปิด"
    toggleBtn.TextColor3 = Color3.fromRGB(200, 200, 200)
    toggleBtn.TextSize, toggleBtn.Font = 12, Enum.Font.GothamBold
    toggleBtn.Parent = frame
    Instance.new("UICorner", toggleBtn).CornerRadius = UDim.new(0, 4)

    local boxLbl = Instance.new("TextLabel")
    boxLbl.Size = UDim2.new(0, 80, 0, 20)
    boxLbl.Position = UDim2.new(0, 12, 0, 38)
    boxLbl.BackgroundTransparency = 1
    boxLbl.Text = "ค่าความแรง (1-100):"
    boxLbl.TextColor3 = Color3.fromRGB(160, 160, 160)
    boxLbl.TextSize, boxLbl.Font, boxLbl.TextXAlignment = 11, Enum.Font.Gotham, Enum.TextXAlignment.Left
    boxLbl.Parent = frame

    local box = Instance.new("TextBox")
    box.Size = UDim2.new(0, 50, 0, 24)
    box.Position = UDim2.new(0, 125, 0, 36)
    box.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
    box.Text = tostring(defaultVal)
    box.TextColor3 = Color3.fromRGB(255, 255, 255)
    box.TextSize, box.Font = 12, Enum.Font.GothamBold
    box.Parent = frame
    Instance.new("UICorner", box).CornerRadius = UDim.new(0, 4)

    local active = false
    local currentVal = defaultVal

    local function updateState()
        if active then
            toggleBtn.BackgroundColor3 = Color3.fromRGB(0, 162, 255)
            toggleBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
            toggleBtn.Text = "เปิด"
        else
            toggleBtn.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
            toggleBtn.TextColor3 = Color3.fromRGB(200, 200, 200)
            toggleBtn.Text = "ปิด"
        end
        callback(active, currentVal)
    end

    toggleBtn.MouseButton1Click:Connect(function()
        active = not active
        updateState()
    end)

    box.FocusLost:Connect(function()
        local val = tonumber(box.Text)
        if val then
            if val < 1 then val = 1 elseif val > 100 then val = 100 end
            box.Text = tostring(val)
            currentVal = val
        else
            box.Text = tostring(defaultVal)
            currentVal = defaultVal
        end
        if active then callback(true, currentVal) end
    end)
end

