-- สร้างเอฟเฟกต์สายตัวอักษรตกแบบเต็มจอและรวดเร็ว
task.spawn(function()
    while activeRain do
        task.spawn(function()
            local streamCol = Instance.new("TextLabel")
            streamCol.Size = UDim2.new(0, 20, 0, math.random(200, 400))
            streamCol.Position = UDim2.new(math.random(), 0, -0.5, 0)
            streamCol.BackgroundTransparency = 1
            streamCol.TextSize = math.random(14, 20)
            streamCol.Font = Enum.Font.Code
            streamCol.TextColor3 = Color3.fromRGB(0, math.random(180, 255), 0)
            streamCol.TextXAlignment = Enum.TextXAlignment.Center
            streamCol.TextYAlignment = Enum.TextYAlignment.Top
            
            -- สุ่มข้อความเป็นสายยาวๆ
            local textStr = ""
            local length = math.random(10, 20)
            for j = 1, length do
                textStr = textStr .. hackerChars[math.random(1, #hackerChars)] .. "\n"
            end
            streamCol.Text = textStr
            streamCol.Parent = HackerRainContainer

            -- วิ่งลงมาด้วยความเร็วสูงจนพ้นจอ
            local speed = math.random(3, 6)
            local elapsed = 0
            while elapsed < 1.5 and activeRain do
                elapsed = elapsed + RunService.RenderStepped:Wait()
                streamCol.Position = streamCol.Position + UDim2.new(0, 0, 0.03 * speed, 0)
            end
            streamCol:Destroy()
        end)
        task.wait(0.02) -- ปล่อยสายลงมาถี่ขึ้น
    end
end)

