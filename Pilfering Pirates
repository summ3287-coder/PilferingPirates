local MainTab = Window:CreateTab("หลัก", 4483362458)
local CharTab = Window:CreateTab("ตัวละคร", 4483362458)
local FunTab = Window:CreateTab("ฟีเจอร์เสริม (Fun)", 4483362458)
local EspTab = Window:CreateTab("มองทะลุ (ESP)", 4483362458)
