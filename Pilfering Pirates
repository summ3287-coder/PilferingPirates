    lbl.TextColor3 = Color3.fromRGB(240, 240, 240)
    lbl.TextSize, lbl.Font, lbl.TextXAlignment = 12, Enum.Font.Gotham, Enum.TextXAlignment.Left
    lbl.Parent = frame

    local colorBtn = Instance.new("TextButton")
    colorBtn.Size = UDim2.new(0, 80, 0, 28)
    colorBtn.Position = UDim2.new(1, -90, 0.5, -14)
    colorBtn.BackgroundColor3 = tracerColors[tracerColorIndex]
    colorBtn.Text = colorNames[tracerColorIndex]
    colorBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    colorBtn.TextSize, colorBtn.Font = 12, Enum.Font.GothamBold
    colorBtn.Parent = frame
    Instance.new("UICorner", colorBtn).CornerRadius = UDim.new(0, 4)

