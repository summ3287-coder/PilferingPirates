local currentPlayingSound = nil

playSoundBtn.MouseButton1Click:Connect(function()
    local soundIdNum = tonumber(soundBox.Text)
    local char = localPlayer.Character
    if soundIdNum and char and char:FindFirstChild("HumanoidRootPart") then
        -- ถ้ามีเสียงเก่าเล่นอยู่ ให้หยุดและลบทิ้งก่อน
        if currentPlayingSound and currentPlayingSound.Parent then
            currentPlayingSound:Stop()
            currentPlayingSound:Destroy()
        end
        
        local sound = Instance.new("Sound")
        sound.SoundId = "rbxassetid://" .. tostring(soundIdNum)
        sound.Volume = 15
        sound.RollOffMaxDistance = 1000
        sound.RollOffMinDistance = 10
        sound.Parent = char.HumanoidRootPart
        
        currentPlayingSound = sound
        sound:Play()
        
        sound.Ended:Connect(function()
            if currentPlayingSound == sound then
                currentPlayingSound = nil
            end
            sound:Destroy()
        end)
    end
end)

stopSoundBtn.MouseButton1Click:Connect(function()
