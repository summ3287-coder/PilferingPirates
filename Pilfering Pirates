    lbl.BackgroundTransparency = 1
    lbl.Text = titleText
    lbl.TextColor3 = Color3.fromRGB(230, 230, 230)
    lbl.TextSize, lbl.Font, lbl.TextXAlignment = 13, Enum.Font.GothamBold, Enum.TextXAlignment.Left
    lbl.Parent = frame

    local switchBg = Instance.new("TextButton")
    switchBg.Size = UDim2.new(0, 48, 0, 26)
    switchBg.Position = UDim2.new(1, -60, 0, 8)
    switchBg.BackgroundColor3 = Color3.fromRGB(45, 45, 50)
    switchBg.Text = ""
    switchBg.AutoButtonColor = false
    switchBg.Parent = frame
    Instance.new("UICorner", switchBg).CornerRadius = UDim.new(1, 0)

    local switchDot = Instance.new("Frame")
    switchDot.Size = UDim2.new(0, 20, 0, 20)
    switchDot.Position = UDim2.new(0, 3, 0.5, -10)
    switchDot.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    switchDot.Parent = switchBg
    Instance.new("UICorner", switchDot).CornerRadius = UDim.new(1, 0)

    local boxLbl = Instance.new("TextLabel")
    boxLbl.Size = UDim2.new(0, 120, 0, 24)
    boxLbl.Position = UDim2.new(0, 16, 0, 42)
    boxLbl.BackgroundTransparency = 1
    boxLbl.Text = "ค่าตัวเลข (1-100):"
    boxLbl.TextColor3 = Color3.fromRGB(150, 150, 150)
    boxLbl.TextSize, boxLbl.Font, boxLbl.TextXAlignment = 12, Enum.Font.Gotham, Enum.TextXAlignment.Left
    boxLbl.Parent = frame

    local box = Instance.new("TextBox")
    box.Size = UDim2.new(0, 60, 0, 26)
    box.Position = UDim2.new(0, 130, 0, 41)
    box.BackgroundColor3 = Color3.fromRGB(35, 35, 40)
    box.Text = tostring(defaultVal)
    box.TextColor3 = Color3.fromRGB(255, 255, 255)
    box.TextSize, box.Font = 12, Enum.Font.GothamBold
    box.Parent = frame
    Instance.new("UICorner", box).CornerRadius = UDim.new(0, 6)

    local active = false
    local currentVal = defaultVal

    switchBg.MouseButton1Click:Connect(function()
        active = not active
        if active then
            switchBg.BackgroundColor3 = Color3.fromRGB(0, 162, 255)
            switchDot:TweenPosition(UDim2.new(1, -23, 0.5, -10), Enum.EasingDirection.Out, Enum.EasingStyle.Quad, 0.15, true)
        else
            switchBg.BackgroundColor3 = Color3.fromRGB(45, 45, 50)
            switchDot:TweenPosition(UDim2.new(0, 3, 0.5, -10), Enum.EasingDirection.Out, Enum.EasingStyle.Quad, 0.15, true)
        end
        callback(active, currentVal)
    end)

    box.FocusLost:Connect(function()
        local val = tonumber(box.Text)
        if val then
            if val < 1 then val = 1 elseif val > 100 then val = 100 end
            box.Text = tostring(val)
            currentVal = val
        else
            box.Text = tostring(defaultVal)
            currentVal = defaultVal
        end
        if active then callback(true, currentVal) end
    end)
end

