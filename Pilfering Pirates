-- [ฟังก์ชันลับที่ 2]: ระบบออร่ากระแทกวัตถรอบตัว (Aura Shockwave)
FunTab:CreateToggle({
   Name = "เปิดออร่าผลักวัตถุกระเด็นรอบตัว",
   CurrentValue = false,
   Flag = "SecretSkill2",
   Callback = function(Value)
       _G.ShockwaveAura = Value
       task.spawn(function()
           while _G.ShockwaveAura do
               local char = LocalPlayer.Character
               if char and char:FindFirstChild("HumanoidRootPart") then
                   for _, obj in pairs(Workspace:GetPartsInPart(char.HumanoidRootPart)) do
                       if obj.Parent ~= char and obj:IsA("BasePart") and not obj.Anchored then
