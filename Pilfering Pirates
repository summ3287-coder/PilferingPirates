-- 1. ฟังก์ชันแท็บหลัก: ระบบตีเร็ว & ระบบล็อกเป้า
-- ----------------------------------------
MainTab:CreateToggle({
   Name = "เปิดระบบตีเร็ว (Fast Attack)",
   CurrentValue = false,
   Flag = "FastAttack",
   Callback = function(Value)
       FastAttackEnabled = Value
       Rayfield:Notify({
          Title = "ระบบตีเร็ว",
          Content = Value and "เปิดใช้งานระบบตีเร็วแล้ว!" or "ปิดระบบตีเร็วแล้ว",
          Duration = 2,
       })
   end,
})

task.spawn(function()
   while true do
       if FastAttackEnabled then
           pcall(function()
               local char = LocalPlayer.Character
               if char then
                   for _, tool in pairs(char:GetChildren()) do
                       if tool:IsA("Tool") and tool:FindFirstChild("Cooldwn") then
                           tool.Cooldwn.Value = 0
                       end
                   end
               end
           end)
       end
       task.wait(0.1)
   end
end)

local lockPlayerList = {}
for _, p in pairs(Players:GetPlayers()) do
   if p ~= LocalPlayer then
       table.insert(lockPlayerList, p.Name)
   end
end

local LockDropdown = MainTab:CreateDropdown({
   Name = "เลือกเป้าหมายที่จะล็อก",
   Options = lockPlayerList,
   CurrentOption = "",
   Flag = "LockTargetDropdown",
   Callback = function(Option)
       if type(Option) == "table" then
           selectedLockPlayer = Option[1] or ""
       else
           selectedLockPlayer = tostring(Option)
       end
   end,
})

Players.PlayerAdded:Connect(function(p)
   if p ~= LocalPlayer then
       table.insert(lockPlayerList, p.Name)
       LockDropdown:Refresh(lockPlayerList)
   end
end)

Players.PlayerRemoving:Connect(function(p)
   for i, v in ipairs(lockPlayerList) do
       if v == p.Name then
           table.remove(lockPlayerList, i)
           break
       end
   end
   LockDropdown:Refresh(lockPlayerList)
end)

MainTab:CreateToggle({
   Name = "เปิดระบบล็อกเป้าผู้เล่น (Lock Target)",
   CurrentValue = false,
   Flag = "LockTargetToggle",
   Callback = function(Value)
       LockTargetEnabled = Value
   end,
})

RunService.RenderStepped:Connect(function()
   if LockTargetEnabled and selectedLockPlayer ~= "" then
       local targetPlayer = Players:FindFirstChild(selectedLockPlayer)
       if targetPlayer and targetPlayer.Character and targetPlayer.Character:FindFirstChild("HumanoidRootPart") then
           local targetHrp = targetPlayer.Character.HumanoidRootPart
           Camera.CFrame = CFrame.new(Camera.CFrame.Position, targetHrp.Position)
       end
   end
end)

-- ----------------------------------------
-- 2. ฟังก์ชันแท็บตัวละคร: ขยายร่าง
-- ----------------------------------------
CharTab:CreateButton({
   Name = "ขยายร่างใหญ่ยักษ์ (Giant Size)",
   Callback = function()
       pcall(function()
           local char = LocalPlayer.Character
           if char and char:FindFirstChild("Humanoid") then
               local humanoid = char.Humanoid
               if char:FindFirstChild("HumanoidDescription") then
                   local desc = humanoid:GetAppliedDescription()
                   desc.HeightScale = 2.5
                   desc.WidthScale = 2.0
                   desc.HeadScale = 2.0
                   humanoid:ApplyDescriptionReset(desc)
               else
                   for _, part in pairs(char:GetChildren()) do
                       if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
                           part.Size = part.Size * 2
                       end
                   end
               end
               Rayfield:Notify({
                  Title = "ขยายร่างสำเร็จ",
                  Content = "แปลงร่างเป็นยักษ์เรียบร้อย!",
                  Duration = 3,
               })
           end
       end)
   end,
})

CharTab:CreateButton({
   Name = "รีเซ็ตขนาดตัวปกติ",
   Callback = function()
       pcall(function()
           local char = LocalPlayer.Character
           if char and char:FindFirstChild("Humanoid") then
               local humanoid = char.Humanoid
               if char:FindFirstChild("HumanoidDescription") then
                   local desc = humanoid:GetAppliedDescription()
                   desc.HeightScale = 1
