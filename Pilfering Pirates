local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()

local Window = Rayfield:CreateWindow({
   Name = "Gemini Hub | John Wick Edition",
   LoadingTitle = "Loading Gemini Hub...",
   LoadingSubtitle = "By John Wick",
   ConfigurationSaving = {
      Enabled = true,
      FolderName = "GeminiHubConfig",
      FileName = "MainConfig"
   },
   KeySystem = false,
})

local MainTab = Window:CreateTab("Main", 4483362458)
local FunTab = Window:CreateTab("Fun & Lag", 4483362458)
local VisualTab = Window:CreateTab("ESP", 4483362458)
local TeleportTab = Window:CreateTab("Teleport", 4483362458)
local UITab = Window:CreateTab("Settings", 4483362458)

local LocalPlayer = game.Players.LocalPlayer
local Workspace = game:GetService("Workspace")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

Rayfield:Notify({
   Title = "Gemini Hub Loaded",
   Content = "John Wick Mode Ready",
   Duration = 4,
   Image = 4483362458,
})

-- Main Tab
MainTab:CreateButton({
   Name = "Fast Attack",
   Callback = function()
       Rayfield:Notify({Title = "Fast Attack", Content = "Activated", Duration = 2})
   end,
})

MainTab:CreateToggle({
   Name = "Target Locking",
   CurrentValue = false,
   Flag = "TargetLock",
   Callback = function(Value)
       _G.TargetLock = Value
   end,
})

MainTab:CreateButton({
   Name = "Chat Spammer",
   Callback = function()
       local args = {[1] = "Gemini Hub On Top!", [2] = "All"}
       game:GetService("ReplicatedStorage").DefaultChatSystemChatEvents.SayMessageRequest:FireServer(unpack(args))
   end,
})

-- Fun & Lag Tab
FunTab:CreateToggle({
   Name = "Noclip",
   CurrentValue = false,
   Flag = "Noclip",
   Callback = function(Value)
       _G.Noclip = Value
       RunService.Stepped:Connect(function()
           if _G.Noclip and LocalPlayer.Character then
               for _, v in pairs(LocalPlayer.Character:GetDescendants()) do
                   if v:IsA("BasePart") then
                       v.CanCollide = false
                   end
               end
           end
       end)
   end,
})

FunTab:CreateSection("Potato Graphics")

FunTab:CreateButton({
   Name = "Potato Level 1: Disable Shadows",
   Callback = function()
       game:GetService("Lighting").GlobalShadows = false
       Rayfield:Notify({Title = "Potato Lv.1", Content = "Shadows disabled", Duration = 2})
   end,
})

FunTab:CreateButton({
   Name = "Potato Level 2: Smooth Plastic",
   Callback = function()
       for _, v in pairs(Workspace:GetDescendants()) do
           if v:IsA("BasePart") then
               v.Material = Enum.Material.SmoothPlastic
           end
       end
       Rayfield:Notify({Title = "Potato Lv.2", Content = "Materials changed to plastic", Duration = 2})
   end,
})

-- ESP Tab
_G.ESPBox = false
_G.ESPColor = Color3.fromRGB(255, 0, 0)

VisualTab:CreateToggle({
   Name = "ESP Box (Highlight)",
   CurrentValue = false,
   Flag = "ESPBoxToggle",
   Callback = function(Value)
       _G.ESPBox = Value
   end,
})

VisualTab:CreateColorPicker({
   Name = "ESP Color",
   Color = Color3.fromRGB(255, 0, 0),
   Flag = "ESPColor",
   Callback = function(Value)
       _G.ESPColor = Value
   end,
})

RunService.RenderStepped:Connect(function()
   for _, player in pairs(game.Players:GetPlayers()) do
       if player ~= LocalPlayer and player.Character then
           local char = player.Character
           local highlight = char:FindFirstChild("GeminiESP")
           
           if _G.ESPBox then
               if not highlight then
                   highlight = Instance.new("Highlight")
                   highlight.Name = "GeminiESP"
                   highlight.Adornee = char
                   highlight.Parent = char
                   highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
               end
               highlight.FillTransparency = 1
               highlight.OutlineTransparency = 0
               highlight.OutlineColor = _G.ESPColor
           else
               if highlight then
                   highlight:Destroy()
               end
           end
       end
   end
end)

-- Teleport Tab
TeleportTab:CreateSection("Smart Teleport")

_G.ClickTP = false

TeleportTab:CreateToggle({
   Name = "Click to Teleport (Tap screen)",
   CurrentValue = false,
   Flag = "ClickTPToggle",
   Callback = function(Value)
       _G.ClickTP = Value
       Rayfield:Notify({Title = "Click TP", Content = Value and "Enabled" else "Disabled", Duration = 2})
   end,
})

UserInputService.InputBegan:Connect(function(input, gameProcessed)
   if not gameProcessed and _G.ClickTP then
       if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
           local mouse = LocalPlayer:GetMouse()
           if mouse.Target and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
               LocalPlayer.Character.HumanoidRootPart.CFrame = CFrame.new(mouse.Hit.Position + Vector3.new(0, 3, 0))
           end
       end
   end
end)

-- Settings Tab
UITab:CreateSection("Config Manager")

UITab:CreateButton({
   Name = "Save Config",
   Callback = function()
       Rayfield:SaveConfiguration()
       Rayfield:Notify({Title = "Config", Content = "Saved successfully", Duration = 2})
   end,
})

UITab:CreateButton({
   Name = "Load Config",
   Callback = function()
       Rayfield:LoadConfiguration()
       Rayfield:Notify({Title = "Config", Content = "Loaded successfully", Duration = 2})
   end,
})
