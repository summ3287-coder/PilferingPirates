-- 3. ฟังก์ชันเดิม: Noclip & Infinite Camera Zoom & ล่องหน
--------------------------------------------------
FunTab:CreateToggle({
   Name = "👻 โหมดทะลุกำแพง (Noclip)",
   CurrentValue = false,
   Flag = "NoclipToggle",
   Callback = function(Value)
       _G.Noclip = Value
       game:GetService("RunService").Stepped:Connect(function()
           if _G.Noclip and LocalPlayer.Character then
               for _, v in pairs(LocalPlayer.Character:GetDescendants()) do
                   if v:IsA("BasePart") then
                       v.CanCollide = false
                   end
               end
           end
       end)
   end,
})

FunTab:CreateToggle({
   Name = "🔍 ซูมกล้องไร้ขีดจำกัด (Infinite Zoom)",
   CurrentValue = true,
   Flag = "ZoomToggle",
   Callback = function(Value)
       if Value then
           LocalPlayer.CameraMaxZoomDistance = 999999
       else
           LocalPlayer.CameraMaxZoomDistance = 400
       end
   end,
})

local InvisibilityEnabled = false
local storedParts = {}
FunTab:CreateToggle({
   Name = "🥷 โหมดล่องหนไร้ร่องรอย (Invisibility)",
   CurrentValue = false,
   Flag = "InvisibilityToggle",
   Callback = function(Value)
       InvisibilityEnabled = Value
       local char = LocalPlayer.Character
       if not char then return end
       if InvisibilityEnabled then
           for _, v in pairs(char:GetDescendants()) do
               if v:IsA("BasePart") or v:IsA("Decal") then
                   storedParts[v] = v.Transparency
                   v.Transparency = 1
               elseif v:IsA("Accessory") then
                   local handle = v:FindFirstChild("Handle")
                   if handle then
                       storedParts[handle] = handle.Transparency
                       handle.Transparency = 1
                   end
               end
           end
           Rayfield:Notify({Title = "🥷 ล่องหนสำเร็จ", Content = "หายตัวจากสายตาคนอื่นแล้ว", Duration = 2})
       else
           for v, originalTransparency in pairs(storedParts) do
               if v and v.Parent then
                   v.Transparency = originalTransparency
               end
           end
           storedParts = {}
           Rayfield:Notify({Title = "🥷 คืนร่างเดิม", Content = "แสดงตัวตนปกติเรียบร้อย", Duration = 2})
       end
   end,
})

