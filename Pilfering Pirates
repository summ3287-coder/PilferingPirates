RunService.RenderStepped:Connect(function()
   for _, player in pairs(game.Players:GetPlayers()) do
       if player ~= LocalPlayer and player.Character then
           local char = player.Character
           local highlight = char:FindFirstChild("GeminiESPBox")
           
           if _G.ESPBoxEnabled then
               if not highlight then
                   highlight = Instance.new("Highlight")
                   highlight.Name = "GeminiESPBox"
                   highlight.Adornee = char
                   highlight.Parent = char
                   highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
               end
               highlight.FillTransparency = 1
               highlight.OutlineTransparency = 0
               highlight.OutlineColor = _G.ESPColor
           else
               if highlight then
                   highlight:Destroy()
               end
           end
       end
   end
end)

TeleportTab:CreateSection("ระบบวาร์ปอัจฉริยะ")

_G.ClickTeleportEnabled = false

TeleportTab:CreateToggle({
   Name = "เปิดใช้งานคลิกวาร์ป (กดจอเพื่อวาร์ปไปจุดนั้น)",
   CurrentValue = false,
   Flag = "ClickTeleportToggle",
   Callback = function(Value)
       _G.ClickTeleportEnabled = Value
       Rayfield:Notify({Title = "Click Teleport", Content = Value and "เปิดโหมดคลิกวาร์ปแล้ว" else "ปิดโหมดคลิกวาร์ปแล้ว", Duration = 2})
   end,
})

UserInputService.InputBegan:Connect(function(input, gameProcessed)
   if not gameProcessed and _G.ClickTeleportEnabled then
       if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
           local mouse = LocalPlayer:GetMouse()
           if mouse.Target and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
               LocalPlayer.Character.HumanoidRootPart.CFrame = CFrame.new(mouse.Hit.Position + Vector3.new(0, 3, 0))
           end
       end
   end
end)

UITab:CreateSection("ระบบปรับแต่งขนาดตัวอักษร UI")

UITab:CreateSlider({
   Name = "ปรับขนาดตัวอักษร (Font Size)",
   Range = {12, 22},
   Increment = 1,
   CurrentValue = 14,
   Flag = "FontSizeSlider",
   Callback = function(Value)
       local coreGui = game:GetService("CoreGui")
       local rayfieldGui = coreGui:FindFirstChild("Rayfield")
