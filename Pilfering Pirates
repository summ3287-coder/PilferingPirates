local featureStates = {}

local function createFeatureToggle(parent, text, yPos, featureKey, callback)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, 0, 0, 40)
    btn.Position = UDim2.new(0, 0, 0, yPos)
    btn.BackgroundColor3 = Color3.fromRGB(26, 26, 32)
    btn.Text = "  " .. text .. " [ ปิด ]"
    btn.TextColor3 = Color3.fromRGB(210, 210, 210)
    btn.TextSize = 12
    btn.Font = Enum.Font.GothamMedium
    btn.TextXAlignment = Enum.TextXAlignment.Left
    btn.Parent = parent
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 8)
    
    featureStates[featureKey] = {
        active = false,
        button = btn,
        defaultText = text,
        callback = callback
    }
    
    btn.MouseButton1Click:Connect(function()
        local stateObj = featureStates[featureKey]
        stateObj.active = not stateObj.active
        if stateObj.active then
            btn.BackgroundColor3 = Color3.fromRGB(0, 120, 80)
            btn.Text = "  " .. text .. " [ เปิดใช้งาน ]"
        else
            btn.BackgroundColor3 = Color3.fromRGB(26, 26, 32)
            btn.Text = "  " .. text .. " [ ปิด ]"
        end
        callback(stateObj.active)
    end)
end

