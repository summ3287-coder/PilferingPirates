createToggleSliderModern(Content1, "ปรับพลังกระโดด (JumpPower)", 0, 50, function(state, val)
    local char = localPlayer.Character
    if char and char:FindFirstChild("Humanoid") then
        if state then char.Humanoid.JumpPower = val * 2 else char.Humanoid.JumpPower = 50 end
    end
end)

createToggleSliderModern(Content1, "ปรับความเร็วเดิน (WalkSpeed)", 85, 50, function(state, val)
    local char = localPlayer.Character
    if char and char:FindFirstChild("Humanoid") then
        if state then char.Humanoid.WalkSpeed = val else char.Humanoid.WalkSpeed = 16 end
    end
end)

local noclipConnection = nil
createModernToggle(Content1, "เดินทะลุกำแพง (Noclip)", 170, false, function(state)
    if state then
        noclipConnection = RunService.Stepped:Connect(function()
            local char = localPlayer.Character
            if char then
                for _, part in ipairs(char:GetDescendants()) do
                    if part:IsA("BasePart") and part.CanCollide then
                        part.CanCollide = false
                    end
                end
            end
        end)
    else
        if noclipConnection then
            noclipConnection:Disconnect()
            noclipConnection = nil
        end
    end
end)

-- --- หน้าที่ 2: ระบบมอง (Tab 2: ESP) ---
local Content2 = Instance.new("ScrollingFrame")
Content2.Size = UDim2.new(1, -24, 1, -125)
Content2.Position = UDim2.new(0, 12, 0, 110)
Content2.BackgroundTransparency = 1
Content2.Visible = false
Content2.CanvasSize = UDim2.new(0, 0, 0, 120)
Content2.ScrollBarThickness = 3
Content2.Parent = MainPanel

local espConnections = {}
createModernToggle(Content2, "เปิดระบบมองตัวผู้เล่น (Player ESP)", 0, false, function(state)
    if state then
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= localPlayer then
                local function addBox(char)
                    if char and not char:FindFirstChild("GeminiESPBox") then
                        local highlight = Instance.new("Highlight")
                        highlight.Name = "GeminiESPBox"
                        highlight.Adornee = char
                        highlight.FillColor = Color3.fromRGB(0, 162, 255)
                        highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
                        highlight.FillTransparency = 0.5
                        highlight.Parent = char
                    end
                end
                if p.Character then addBox(p.Character) end
                table.insert(espConnections, p.CharacterAdded:Connect(addBox))
            end
        end
        table.insert(espConnections, Players.PlayerAdded:Connect(function(p)
            p.CharacterAdded:Connect(function(char)
                if Content2.Visible then
                    local highlight = Instance.new("Highlight")
                    highlight.Name = "GeminiESPBox"
                    highlight.Adornee = char
                    highlight.FillColor = Color3.fromRGB(0, 162, 255)
                    highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
                    highlight.FillTransparency = 0.5
                    highlight.Parent = char
                end
            end)
        end))
    else
        for _, conn in ipairs(espConnections) do conn:Disconnect() end
        espConnections = {}
        for _, p in ipairs(Players:GetPlayers()) do
            if p.Character and p.Character:FindFirstChild("GeminiESPBox") then
                p.Character.GeminiESPBox:Destroy()
            end
        end
    end
end)

